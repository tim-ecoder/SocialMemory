<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Photo area -->
        <ImageView
            android:id="@+id/photo_image"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center_horizontal"
            android:scaleType="centerCrop"
            android:background="@color/surface_variant"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tv_tap_to_add_photo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="@string/add_photo"
            android:textSize="14sp"
            android:textColor="@color/on_surface_variant" />

        <!-- Basic info -->
        <EditText
            android:id="@+id/et_first_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/first_name"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:textSize="16sp"
            android:textColor="@color/on_surface" />

        <EditText
            android:id="@+id/et_last_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/last_name"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:textSize="16sp"
            android:textColor="@color/on_surface" />

        <EditText
            android:id="@+id/et_company"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/company"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:textSize="16sp"
            android:textColor="@color/on_surface" />

        <EditText
            android:id="@+id/et_position"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/job_position"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:textSize="16sp"
            android:textColor="@color/on_surface" />

        <EditText
            android:id="@+id/et_context_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/acquaintance_context"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:maxLength="200"
            android:textSize="16sp"
            android:textColor="@color/on_surface" />

        <EditText
            android:id="@+id/et_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/note"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:textSize="16sp"
            android:textColor="@color/on_surface" />

        <!-- Section header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/additional_info"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:paddingTop="8dp"
            android:paddingBottom="4dp" />

        <EditText
            android:id="@+id/et_hobbies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/hobbies"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="3"
            android:textSize="16sp"
            android:textColor="@color/on_surface" />

        <EditText
            android:id="@+id/et_interests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/interests"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="3"
            android:textSize="16sp"
            android:textColor="@color/on_surface" />

        <EditText
            android:id="@+id/et_family_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/family_status"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:textSize="16sp"
            android:textColor="@color/on_surface" />

        <EditText
            android:id="@+id/et_partner_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/partner_name"
            android:inputType="textPersonName"
            android:maxLines="1"
            android:textSize="16sp"
            android:textColor="@color/on_surface" />

        <EditText
            android:id="@+id/et_children_names"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/children_names"
            android:inputType="textCapWords"
            android:maxLines="2"
            android:textSize="16sp"
            android:textColor="@color/on_surface" />

        <EditText
            android:id="@+id/et_pet_names"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/pet_names"
            android:inputType="textCapWords"
            android:maxLines="2"
            android:textSize="16sp"
            android:textColor="@color/on_surface" />

        <EditText
            android:id="@+id/et_religion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/religion"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:textSize="16sp"
            android:textColor="@color/on_surface" />

        <EditText
            android:id="@+id/et_political_views"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:hint="@string/political_views"
            android:inputType="textCapWords"
            android:maxLines="2"
            android:textSize="16sp"
            android:textColor="@color/on_surface" />

        <!-- Save button -->
        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/save"
            android:textColor="@color/white"
            android:background="@color/primary"
            android:textSize="16sp"
            android:padding="12dp" />

    </LinearLayout>

</ScrollView>
