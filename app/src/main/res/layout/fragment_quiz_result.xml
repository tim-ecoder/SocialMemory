<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="@color/background">

    <!-- Large percentage display -->
    <TextView
        android:id="@+id/tv_percentage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="8dp"
        android:text="0%"
        android:textSize="64sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:gravity="center" />

    <!-- "X correct out of Y" -->
    <TextView
        android:id="@+id/tv_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:textSize="18sp"
        android:textColor="@color/on_surface_variant"
        android:gravity="center" />

    <!-- "People to review" header – only shown when there are mistakes -->
    <TextView
        android:id="@+id/tv_review_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/people_to_review"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/on_surface"
        android:visibility="gone" />

    <!-- List of people answered wrong -->
    <ListView
        android:id="@+id/list_mistakes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp"
        android:divider="@color/surface_variant"
        android:dividerHeight="1dp"
        android:visibility="gone" />

    <!-- Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btn_retry_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/retry_all"
            android:textColor="@color/white"
            android:background="@color/primary"
            android:textSize="16sp"
            android:padding="12dp" />

        <Button
            android:id="@+id/btn_retry_mistakes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/retry_mistakes"
            android:textColor="@color/primary"
            android:background="@color/primary_light"
            android:textSize="16sp"
            android:padding="12dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_back_to_event"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/back_to_event"
            android:textColor="@color/on_surface"
            android:background="@color/surface_variant"
            android:textSize="16sp"
            android:padding="12dp" />

    </LinearLayout>

</LinearLayout>
