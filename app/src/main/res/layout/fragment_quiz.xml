<?xml version="1.0" encoding="utf-8"?>
<!--
    Quiz fragment layout.
    The fragment code shows/hides the relevant sub-views depending on the
    current question mode:
      • quiz_photo_question  – visible for MODE_PHOTO_TO_NAME
      • quiz_text_question   – visible for text-prompt modes
      • answer_buttons_container – visible for name/position answer modes
      • answer_photos_container  – visible for photo answer modes
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Top: progress bar + question counter -->
    <LinearLayout
        android:id="@+id/quiz_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:layout_gravity="top">

        <ProgressBar
            android:id="@+id/quiz_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:progressTint="@color/primary"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/quiz_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 / 10"
            android:textSize="14sp"
            android:textColor="@color/on_surface_variant" />

    </LinearLayout>

    <!-- Centre content area -->
    <FrameLayout
        android:id="@+id/quiz_content_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="72dp"
        android:paddingBottom="280dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp">

        <!-- Large photo for photo-question modes (MODE_PHOTO_TO_NAME) -->
        <ImageView
            android:id="@+id/quiz_photo"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:background="@color/surface_variant"
            android:visibility="gone" />

        <!-- Text prompt for text-question modes -->
        <TextView
            android:id="@+id/quiz_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:textSize="20sp"
            android:textColor="@color/on_surface"
            android:lineSpacingMultiplier="1.3"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Bottom answer area -->
    <FrameLayout
        android:id="@+id/quiz_answer_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:padding="16dp">

        <!-- 4 text answer buttons (name / position modes) -->
        <LinearLayout
            android:id="@+id/answer_buttons_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/answer_btn_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textSize="15sp"
                android:textColor="@color/on_surface"
                android:background="@color/surface_variant"
                android:padding="12dp" />

            <Button
                android:id="@+id/answer_btn_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textSize="15sp"
                android:textColor="@color/on_surface"
                android:background="@color/surface_variant"
                android:padding="12dp" />

            <Button
                android:id="@+id/answer_btn_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:textSize="15sp"
                android:textColor="@color/on_surface"
                android:background="@color/surface_variant"
                android:padding="12dp" />

            <Button
                android:id="@+id/answer_btn_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="@color/on_surface"
                android:background="@color/surface_variant"
                android:padding="12dp" />

        </LinearLayout>

        <!-- 2×2 photo grid for photo-answer modes -->
        <GridLayout
            android:id="@+id/answer_photos_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:visibility="gone">

            <ImageView
                android:id="@+id/answer_photo_0"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerCrop"
                android:background="@color/surface_variant"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/answer_photo_1"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerCrop"
                android:background="@color/surface_variant"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/answer_photo_2"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerCrop"
                android:background="@color/surface_variant"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/answer_photo_3"
                android:layout_width="0dp"
                android:layout_height="150dp"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:layout_margin="4dp"
                android:scaleType="centerCrop"
                android:background="@color/surface_variant"
                android:clickable="true"
                android:focusable="true" />

        </GridLayout>

    </FrameLayout>

</FrameLayout>
